    {
      "parameters": {
        "jsCode": "// Enforce strict input validation before sending payloads to the LLM\nfor (const item of $input.all()) {\n  const body = item.json.body || {};\n  \n  const name = (body.name || \"\").trim();\n  const email = (body.email || \"\").trim();\n  const message = (body.message || \"\").trim();\n  \n  // Basic Email Regex Validation\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  const isValidEmail = emailRegex.test(email);\n\n  // Check for required elements\n  if (!name || !isValidEmail || !message) {\n    item.json.validation_failed = true;\n    item.json.validation_error = \"Missing required fields or invalid email format.\";\n  } else {\n    item.json.validation_failed = false;\n    // Sanitize data to strip out any unwanted HTML tags or injection attempts\n    item.json.body.name = name.replace(/<\\/?[^>]+(>|$)/g, \"\");\n    item.json.body.message = message.replace(/<\\/?[^>]+(>|$)/g, \"\");\n  }\n}\n\nreturn $input.all();"
      },
